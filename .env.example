# ===================================================================
# Full-Stack E-Commerce Application Environment Template
# Place real secrets into Render / Vercel environment dashboards or local .env
# NEVER commit real secret values to Git!
# ===================================================================

# --- BACKEND ENVIRONMENT VARIABLES (Render / Local) ---
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=https://your-app-name.vercel.app,http://localhost:5173

# Database Configuration (Neon PostgreSQL in Production)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Authentication Secret
JWT_SECRET=your_strong_base64_or_random_string_secret_here

# Kafka Configuration (Aiven Kafka Free Tier)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=ecom-kafka-yourproject.aivencloud.com:28045
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="avnadmin" password="YOUR_AIVEN_PASSWORD_HERE";

# Razorpay Payment Gateway
RAZORPAY_API_KEY=rzp_live_or_test_key_id
RAZORPAY_API_SECRET=your_razorpay_secret_key

# Email / SMTP Notifications
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_digit_app_password

# --- FRONTEND ENVIRONMENT VARIABLES (Vercel) ---
VITE_API_URL=https://your-backend-name.onrender.com/api
